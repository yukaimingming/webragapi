<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>63062d6a-0e41-4d0a-9980-f39ae4d80e9d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion" Version="10.9.0-preview.1.26411.16" />
    <PackageReference Include="Microsoft.Extensions.DataIngestion.Markdig" Version="10.9.0-preview.1.26411.16" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="3.0.0-preview.26160.2" />
    <PackageReference Include="OpenMcdf" Version="3.2.0" />
    <PackageReference Include="PdfPig" Version="0.1.17-alpha-202608270140-4a0ec" />
    <PackageReference Include="Qdrant.Client" Version="1.19.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- 更新包必须随 WebAPI 输出和发布目录复制，避免接口清单正常但下载地址返回 404。 -->
    <Content Update="wwwroot\updates\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
